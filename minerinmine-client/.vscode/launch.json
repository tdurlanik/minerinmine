{
  // VS Code hata ayiklama yapilandirmalari.
  // Kullanim: sol menude "Run and Debug" (Ctrl+Shift+D) -> yapilandirmayi sec -> F5
  "version": "0.2.0",
  "configurations": [
    {
      // ng serve'i baslatir VE tarayiciyi VS Code'a bagli olarak acar.
      // Boylece .ts dosyalarina dogrudan VS Code icinden breakpoint koyabilirsiniz.
      // (Ornek: auth.service.ts icindeki saveSession metodu)
      "name": "ng serve (debug)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
